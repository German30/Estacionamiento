<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Estacionamiento.Web</RootNamespace>
    <!-- Los comentarios XML alimentan la documentación OpenAPI (ver Program.cs). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: no se exige comentario en cada miembro público, sólo en lo que documenta la API.
      CS1573: los contratos documentan sólo los campos que no se explican por su nombre; exigir
      un <param> para "Placa" o "Entrada" llena el OpenAPI de ruido y esconde lo que sí importa.
    -->
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Estacionamiento.Infraestructura\Estacionamiento.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
